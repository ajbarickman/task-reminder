# NextAuth / Auth.js Configuration
AUTH_SECRET="your-random-32-character-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials (Get these from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Vercel Postgres Connection Strings
# (When deployed on Vercel and connected to a Vercel Postgres Database, these are automatically injected by Vercel!)
POSTGRES_PRISMA_URL="postgres://default:password@ep-something.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://default:password@ep-something.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# Twilio SMS Credentials (Get these from your twilio.com console)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15550001234"
